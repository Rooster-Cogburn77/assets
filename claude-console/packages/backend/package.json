{
  "name": "@claude-console/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for Claude Console - WebSocket streaming and session management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
